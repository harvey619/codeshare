{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/api/*", "/go", "/go/*"]
  },
  // Workers AI for "Explain this code" (free plan: 10,000 Neurons/day, then requests just fail).
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      // Lists rooms for the admin page.
      { "name": "Directory", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ]
}