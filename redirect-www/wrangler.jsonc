{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Cloudflare creates the DNS record for a custom domain itself.
  "routes": [{ "pattern": "www.harveycodes.com", "custom_domain": true }]
}
